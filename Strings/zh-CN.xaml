    <sys:String x:Key="Str_Portable">便携版</sys:String>
    <sys:String x:Key="Str_Btn_Install">安装 KillerFind...</sys:String>
    <sys:String x:Key="Str_Btn_DoInstall">安装</sys:String>
    <sys:String x:Key="Str_Dlg_InstallMsg">将 KillerFind 安装到你的用户配置文件？</sys:String>
    <sys:String x:Key="Str_Dlg_InstallBullets">- 开始菜单快捷方式&#x0A;- 显示在添加/删除程序中</sys:String>
    <sys:String x:Key="Str_Chk_Desktop">桌面快捷方式</sys:String>
    <sys:String x:Key="Str_Dlg_QuitMsg">退出 KillerFind？</sys:String>
