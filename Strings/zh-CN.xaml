    <sys:String x:Key="Str_Status_Done">用时 {0} 秒  -  匹配到 {1} 个文件。</sys:String>
    <sys:String x:Key="Str_Status_Stopped">已停止。</sys:String>
    <sys:String x:Key="Str_Status_Cleared">已清除。</sys:String>
    <sys:String x:Key="Str_Status_NothingExport">暂无可导出的内容。</sys:String>
    <sys:String x:Key="Str_Status_Exported">已导出：{0}</sys:String>
