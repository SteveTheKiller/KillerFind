    <!-- Help card: shortcuts -->
    <sys:String x:Key="Str_Help_Shortcuts">快捷键</sys:String>
    <sys:String x:Key="Str_Ks_Run">运行搜索</sys:String>
    <sys:String x:Key="Str_Ks_Esc">关闭弹窗、停止搜索，然后询问是否退出</sys:String>
    <sys:String x:Key="Str_Ks_FilterResults">筛选结果</sys:String>
    <sys:String x:Key="Str_Ks_NewTab">新建搜索标签页</sys:String>
    <sys:String x:Key="Str_Ks_CloseTab">关闭当前标签页</sys:String>
    <sys:String x:Key="Str_Ks_NextTab">下一个标签页（Shift：上一个）</sys:String>
