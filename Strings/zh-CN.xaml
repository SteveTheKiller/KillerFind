    <sys:String x:Key="Str_Ks_AddTerm">添加搜索词</sys:String>
    <sys:String x:Key="Str_Ks_AddFilter">添加过滤器</sys:String>
    <sys:String x:Key="Str_Ks_Folder">选择文件夹</sys:String>
    <sys:String x:Key="Str_Ks_Help">显示此卡片</sys:String>

