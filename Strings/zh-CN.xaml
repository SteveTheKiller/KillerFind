<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         KillerFind - English (en-US) strings. x:Key values are looked up at
         runtime; never change them. Other locales layer over this file; any
         key they omit falls back here. {0}/{1} placeholders are filled by the
         app - keep them.
         ================================================================ -->

    <!-- Title bar / flyout -->
    <sys:String x:Key="Str_TT_Language">语言</sys:String>
    <sys:String x:Key="Str_TT_Theme">主题</sys:String>
    <sys:String x:Key="Str_Lbl_Theme">主题</sys:String>
    <sys:String x:Key="Str_Lbl_Accent">强调色</sys:String>

    <!-- Scope bar -->
    <sys:String x:Key="Str_Lbl_In">范围：</sys:String>
    <sys:String x:Key="Str_Scope_Empty">(未选择文件夹 - 点击以选择)</sys:String>
    <sys:String x:Key="Str_TT_Scope">点击以更改搜索文件夹</sys:String>
    <sys:String x:Key="Str_Dlg_SelectFolder">选择根搜索文件夹</sys:String>

    <!-- Search config -->
    <sys:String x:Key="Str_Lbl_Filters">筛选</sys:String>
    <sys:String x:Key="Str_Lbl_Include">包含</sys:String>
    <sys:String x:Key="Str_Lbl_Exclude">排除</sys:String>
    <sys:String x:Key="Str_TT_Include">用分号分隔的模式，例如 *.txt;*.log</sys:String>
