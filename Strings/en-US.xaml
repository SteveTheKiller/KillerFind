<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         KillerFind - English (en-US) strings. x:Key values are looked up at
         runtime; never change them. Other locales layer over this file; any
         key they omit falls back here. {0}/{1} placeholders are filled by the
         app - keep them.
         ================================================================ -->

    <!-- Title bar / flyout -->
    <sys:String x:Key="Str_TT_Language">Language</sys:String>
    <sys:String x:Key="Str_TT_Theme">Theme</sys:String>
    <sys:String x:Key="Str_Lbl_Theme">theme</sys:String>
    <sys:String x:Key="Str_Lbl_Accent">accent</sys:String>

    <!-- Scope bar -->
    <sys:String x:Key="Str_Lbl_In">in:</sys:String>
    <sys:String x:Key="Str_Scope_Empty">(no folder selected - click to choose)</sys:String>
    <sys:String x:Key="Str_TT_Scope">Click to change search folder</sys:String>
    <sys:String x:Key="Str_Dlg_SelectFolder">Select root search folder</sys:String>

    <!-- Search config -->
    <sys:String x:Key="Str_Lbl_Filters">FILTERS</sys:String>
    <sys:String x:Key="Str_Lbl_Include">include</sys:String>
    <sys:String x:Key="Str_Lbl_Exclude">exclude</sys:String>
    <sys:String x:Key="Str_TT_Include">Semicolon-separated patterns, e.g. *.txt;*.log</sys:String>
    <sys:String x:Key="Str_TT_Exclude">Semicolon-separated paths or patterns to skip</sys:String>
    <sys:String x:Key="Str_Chk_CaseSensitive">case sensitive</sys:String>
    <sys:String x:Key="Str_Btn_AddFilter">+ add filter</sys:String>
    <sys:String x:Key="Str_Lbl_Advanced">advanced</sys:String>
    <sys:String x:Key="Str_Filter_Ext">extension</sys:String>
    <sys:String x:Key="Str_Filter_Date">date modified</sys:String>
    <sys:String x:Key="Str_Filter_Size">size</sys:String>
    <sys:String x:Key="Str_Cond_Is">is</sys:String>
    <sys:String x:Key="Str_Cond_IsNot">is not</sys:String>
    <sys:String x:Key="Str_Cond_Before">before</sys:String>
    <sys:String x:Key="Str_Cond_After">after</sys:String>
    <sys:String x:Key="Str_Cond_Larger">over</sys:String>
    <sys:String x:Key="Str_Cond_Smaller">under</sys:String>

    <!-- Pattern help card -->
    <sys:String x:Key="Str_TT_PatternHelp">Pattern help</sys:String>
    <sys:String x:Key="Str_Help_Title">PATTERNS</sys:String>
    <sys:String x:Key="Str_Help_Star">everything ending in .log</sys:String>
    <sys:String x:Key="Str_Help_Prefix">names starting with report</sys:String>
    <sys:String x:Key="Str_Help_Middle">names containing 2024</sys:String>
    <sys:String x:Key="Str_Help_Q">? stands for exactly one character</sys:String>
    <sys:String x:Key="Str_Help_List">list several patterns with ; between them</sys:String>
    <sys:String x:Key="Str_Help_Plain">plain text works too - matches names containing it</sys:String>
    <sys:String x:Key="Str_Help_Exclude">exclude also skips whole folders by name</sys:String>

    <!-- Tabs -->
    <sys:String x:Key="Str_Tab_New">new search</sys:String>
    <sys:String x:Key="Str_TT_NewTab">New search tab</sys:String>
    <sys:String x:Key="Str_TT_CloseTab">Close tab</sys:String>

    <!-- Folder picker -->
    <sys:String x:Key="Str_Btn_Cancel">Cancel</sys:String>
    <sys:String x:Key="Str_Btn_Select">Select</sys:String>
    <sys:String x:Key="Str_QA_Home">Home</sys:String>
    <sys:String x:Key="Str_QA_Desktop">Desktop</sys:String>
    <sys:String x:Key="Str_QA_Documents">Documents</sys:String>
    <sys:String x:Key="Str_QA_Downloads">Downloads</sys:String>
    <sys:String x:Key="Str_QA_Pictures">Pictures</sys:String>
    <sys:String x:Key="Str_TT_Up">Up one folder</sys:String>
    <sys:String x:Key="Str_Dlg_NoSubfolders">(no subfolders - click Select to use this folder)</sys:String>
    <sys:String x:Key="Str_Col_Name">name</sys:String>
    <sys:String x:Key="Str_Col_Folder">location</sys:String>
    <sys:String x:Key="Str_Sort_Found">as found</sys:String>
    <sys:String x:Key="Str_TT_FilterResults">Filter these results (Ctrl+F)</sys:String>
    <sys:String x:Key="Str_TT_Pipe">Search within these results</sys:String>
    <sys:String x:Key="Str_Menu_PipeTab">Search within these results</sys:String>
    <sys:String x:Key="Str_Pipe_Scope">{0} results from {1}  |  {2}</sys:String>
    <sys:String x:Key="Str_Status_NoPipe">No results to search within yet.</sys:String>

    <!-- Portable install + quit dialog -->
    <sys:String x:Key="Str_Portable">PORTABLE</sys:String>
    <sys:String x:Key="Str_Btn_Install">Install KillerFind...</sys:String>
    <sys:String x:Key="Str_Btn_DoInstall">Install</sys:String>
    <sys:String x:Key="Str_Dlg_InstallMsg">Install KillerFind to your user profile?</sys:String>
    <sys:String x:Key="Str_Dlg_InstallBullets">- Start Menu shortcut&#x0A;- Appears in Add/Remove Programs</sys:String>
    <sys:String x:Key="Str_Chk_Desktop">Desktop shortcut</sys:String>
    <sys:String x:Key="Str_Dlg_QuitMsg">Quit KillerFind?</sys:String>
    <sys:String x:Key="Str_Chk_RememberTabs">Remember my open tabs</sys:String>
    <sys:String x:Key="Str_Chk_RememberChoice">Remember my choice</sys:String>
    <sys:String x:Key="Str_Btn_Quit">Quit</sys:String>
    <sys:String x:Key="Str_Col_Size">size</sys:String>
    <sys:String x:Key="Str_Col_Modified">modified</sys:String>
    <sys:String x:Key="Str_Sum_Counts">{0} folder(s), {1} file(s)</sys:String>
    <sys:String x:Key="Str_TT_ViewList">List view</sys:String>
    <sys:String x:Key="Str_TT_ViewIcons">Icon view</sys:String>
    <sys:String x:Key="Str_TT_ViewDetails">Details view</sys:String>
    <sys:String x:Key="Str_Lbl_SearchTerms">SEARCH TERMS</sys:String>
    <sys:String x:Key="Str_Btn_AddTerm">+ add term</sys:String>
    <sys:String x:Key="Str_Btn_AddGroup">+ add group</sys:String>
    <sys:String x:Key="Str_Btn_Clear">CLEAR</sys:String>

    <!-- Search button (code-behind swaps idle/stop; keep the brackets) -->
    <sys:String x:Key="Str_Btn_Search">SEARCH</sys:String>
    <sys:String x:Key="Str_Btn_Stop">STOP</sys:String>

    <!-- Results -->
    <sys:String x:Key="Str_Lbl_Results">RESULTS</sys:String>
    <sys:String x:Key="Str_Lbl_ResultsCount">RESULTS  ({0})</sys:String>
    <sys:String x:Key="Str_Btn_Export">EXPORT HTML</sys:String>
    <sys:String x:Key="Str_TT_Result">Click to expand  |  Double-click to reveal in Explorer  |  Right-click for more</sys:String>
    <sys:String x:Key="Str_Btn_ExpandAll">EXPAND ALL</sys:String>
    <sys:String x:Key="Str_Btn_CollapseAll">COLLAPSE ALL</sys:String>
    <sys:String x:Key="Str_Menu_OpenFile">Open file</sys:String>
    <sys:String x:Key="Str_Menu_OpenWith">Open with...</sys:String>
    <sys:String x:Key="Str_Menu_ShowExplorer">Show in Explorer</sys:String>
    <sys:String x:Key="Str_Menu_Minimize">Minimize</sys:String>
    <sys:String x:Key="Str_Menu_Maximize">Maximize</sys:String>
    <sys:String x:Key="Str_Menu_Restore">Restore</sys:String>
    <sys:String x:Key="Str_Menu_Close">Close</sys:String>

    <!-- Status messages -->
    <sys:String x:Key="Str_Status_Ready">Ready</sys:String>
    <sys:String x:Key="Str_Status_InvalidRoot">Invalid or missing root path.</sys:String>
    <sys:String x:Key="Str_Status_NoTerms">Add at least one search term or filter.</sys:String>
    <sys:String x:Key="Str_Status_Done">Done in {0}s  -  {1} file(s) matched.</sys:String>
    <sys:String x:Key="Str_Status_Stopped">Stopped.</sys:String>
    <sys:String x:Key="Str_Status_Cleared">Cleared.</sys:String>
    <sys:String x:Key="Str_Status_NothingExport">Nothing to export yet.</sys:String>
    <sys:String x:Key="Str_Status_Exported">Exported: {0}</sys:String>
    <sys:String x:Key="Str_Status_ExportFailed">Export failed: {0}</sys:String>
    <sys:String x:Key="Str_Status_Scanned">{0} files scanned</sys:String>
    <sys:String x:Key="Str_Count_Matches">{0} matches</sys:String>

    <!-- About overlay -->
    <sys:String x:Key="Str_About_Tagline">Fast file search for Windows. No indexing.</sys:String>
    <sys:String x:Key="Str_About_Version">VERSION</sys:String>
    <sys:String x:Key="Str_About_Publisher">PUBLISHER</sys:String>
    <sys:String x:Key="Str_About_Thumbprint">THUMBPRINT</sys:String>
    <sys:String x:Key="Str_About_Sha">SHA-256</sys:String>
    <sys:String x:Key="Str_About_Footer">GPLv3  |  built by a field tech</sys:String>

    <!-- HTML report (exported in the app's current language) -->
    <sys:String x:Key="Str_Rpt_Meta">Generated {0} &#183; {1} files &#183; {2} matches</sys:String>
    <sys:String x:Key="Str_Rpt_Query">Searched {0} for {1}.</sys:String>
    <sys:String x:Key="Str_Rpt_TermName">file names containing {0}</sys:String>
    <sys:String x:Key="Str_Rpt_TermContent">file contents containing {0}</sys:String>
    <sys:String x:Key="Str_Rpt_Everything">everything</sys:String>
    <sys:String x:Key="Str_Rpt_Or">or</sys:String>
    <sys:String x:Key="Str_Rpt_Found">found by</sys:String>
    <sys:String x:Key="Str_Rpt_More">... +{0} more</sys:String>
    <sys:String x:Key="Str_Rpt_GenBy">Generated by {0}</sys:String>

    <!-- Term/group chips + tooltips (computed in the models, re-raised on language switch) -->
    <sys:String x:Key="Str_Mode_Name">name</sys:String>
    <sys:String x:Key="Str_Mode_Content">content</sys:String>
    <sys:String x:Key="Str_TT_ModeName">Filename / wildcard  (e.g. *.log)</sys:String>
    <sys:String x:Key="Str_TT_ModeContent">Content search  (text inside files)</sys:String>
    <sys:String x:Key="Str_Group_Any">ANY</sys:String>
    <sys:String x:Key="Str_Group_All">ALL</sys:String>
    <sys:String x:Key="Str_TT_GroupAny">ANY: a file matches if any term in this group hits</sys:String>
    <sys:String x:Key="Str_TT_GroupAll">ALL: a file must match every term in this group</sys:String>
    <sys:String x:Key="Str_Join_And">AND</sys:String>
    <sys:String x:Key="Str_Join_Or">OR</sys:String>
    <!-- Quit dialog: opt-out tab checkbox (unchecked = tabs are remembered) -->
    <sys:String x:Key="Str_Chk_CloseTabs">Close my open tabs</sys:String>

    <!-- Help card: keyboard shortcuts section (F1) -->
    <sys:String x:Key="Str_Help_Shortcuts">Shortcuts</sys:String>
    <sys:String x:Key="Str_Ks_Run">run the search</sys:String>
    <sys:String x:Key="Str_Ks_Esc">close popups, stop the search, then offer to quit</sys:String>
    <sys:String x:Key="Str_Ks_FilterResults">filter the results</sys:String>
    <sys:String x:Key="Str_Ks_NewTab">new search tab</sys:String>
    <sys:String x:Key="Str_Ks_CloseTab">close the current tab</sys:String>
    <sys:String x:Key="Str_Ks_NextTab">next tab (Shift: previous)</sys:String>
    <sys:String x:Key="Str_Ks_JumpTab">jump to tab 1-9 (9 = last)</sys:String>
    <sys:String x:Key="Str_Ks_AddTerm">add a search term</sys:String>
    <sys:String x:Key="Str_Ks_AddFilter">add a filter</sys:String>
    <sys:String x:Key="Str_Ks_Folder">choose the folder</sys:String>
    <sys:String x:Key="Str_Ks_Help">show this card</sys:String>

</ResourceDictionary>
