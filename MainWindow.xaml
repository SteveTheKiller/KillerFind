<Window x:Class="KillerFind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerFind"
        xmlns:models="clr-namespace:KillerFind.Models"
        Title="KillerFind"
        Icon="Resources/kf-icon.ico"
        Height="700" Width="1200" MinHeight="500" MinWidth="800"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        BorderThickness="0"
        BorderBrush="Transparent"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- custom titlebar -->
            <RowDefinition Height="34"/>   <!-- scope bar       -->
            <RowDefinition Height="28"/>   <!-- run status bar  -->
            <RowDefinition Height="*"/>    <!-- main content    -->
            <RowDefinition Height="24"/>   <!-- footer          -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             ROW 0 — CUSTOM TITLE BAR  (drag to move, dbl-click to max)
        ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="&gt;_" Foreground="{StaticResource PrimaryBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <TextBlock Text="KillerFind" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="file search" Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                </StackPanel>

                <!-- Window controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <Button x:Name="MinimizeBtn" Content="&#x2015;"
                            Style="{StaticResource ChromeButton}"
                            Click="MinimizeBtn_Click"/>
                    <Button x:Name="MaximizeBtn" Content="&#x25A1;"
                            Style="{StaticResource ChromeButton}"
                            Click="MaximizeBtn_Click"/>
                    <Button x:Name="CloseBtn" Content="&#x2715;"
                            Style="{StaticResource CloseButton}"
                            Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 1 — SCOPE BAR
        ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                x:Name="ScopeBar"
                Background="{StaticResource SinkBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Cursor="Hand"
                ToolTip="Click to change search folder"
                MouseLeftButtonUp="ScopeBar_Click">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="in:"
                           Foreground="{StaticResource DimTextBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBlock x:Name="ScopePathLabel"
                           Grid.Column="1"
                           Text="(no folder selected — click to choose)"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                <!-- Hidden TextBox keeps RootPathBox name for code-behind compat -->
                <TextBox x:Name="RootPathBox" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 2 — RUN STATUS BAR
        ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SinkBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="0,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- green accent bar -->
                    <ColumnDefinition Width="*"/>     <!-- status text      -->
                    <ColumnDefinition Width="Auto"/>  <!-- scanned          -->
                    <ColumnDefinition Width="Auto"/>  <!-- matches          -->
                </Grid.ColumnDefinitions>

                <!-- Green left accent -->
                <Border Grid.Column="0"
                        Width="3"
                        Background="{StaticResource PrimaryBrush}"
                        Margin="0,4,12,4"
                        CornerRadius="2"/>

                <!-- Current file / done message -->
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Ready"
                           Foreground="{StaticResource DimTextBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Scanned counter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="ScannedText"
                               Foreground="{StaticResource DimTextBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Match count -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatsText"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 3 — MAIN 2-PANEL GRID
        ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="265" MinWidth="200" MaxWidth="380"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"   MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- ────────────────────────────────────────────────
                 COLUMN 0 — SEARCH CONFIG
            ──────────────────────────────────────────────────── -->
            <DockPanel Grid.Column="0"
                       Background="{StaticResource BackgroundBrush}"
                       LastChildFill="True">

                <!-- Action buttons (pinned to bottom) -->
                <Border DockPanel.Dock="Bottom" Padding="12,8"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Button x:Name="SearchButton"
                                Content="SEARCH"
                                Style="{StaticResource PrimaryButton}"
                                Height="34"
                                Click="Search_Click"/>
                        <Button Content="CLEAR"
                                Style="{StaticResource SurfaceButton}"
                                Height="28"
                                Margin="0,6,0,0"
                                Click="Clear_Click"/>
                    </StackPanel>
                </Border>

                <!-- Filters (above action buttons) -->
                <Border DockPanel.Dock="Bottom" Padding="12,8"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="FILTERS" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="include" Foreground="{StaticResource DimTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10" Margin="0,0,0,3"/>
                        <TextBox x:Name="IncludePatternsBox"
                                 Text="*.*"
                                 ToolTip="Semicolon-separated patterns, e.g. *.txt;*.log"/>
                        <TextBlock Text="exclude" Foreground="{StaticResource DimTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10" Margin="0,7,0,3"/>
                        <TextBox x:Name="ExcludePatternsBox"
                                 Text=""
                                 ToolTip="Semicolon-separated paths or patterns to skip"/>
                        <CheckBox x:Name="CaseSensitiveCheck"
                                  Content="case sensitive"
                                  Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Search terms — fills remaining space -->
                <Border Padding="12,8,12,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="SEARCH TERMS"
                                   Style="{StaticResource SectionHeader}"/>
                        <Button DockPanel.Dock="Bottom"
                                Content="+ add term"
                                Style="{StaticResource SurfaceButton}"
                                Margin="0,6,0,0"
                                Height="26"
                                Click="AddTerm_Click"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TermsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SearchTerm}">
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="0,0,0,5"
                                                Padding="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Mode toggle [F]/[C] -->
                                                <Button Grid.Column="0"
                                                        Content="{Binding ModeLabel, Mode=OneWay}"
                                                        Style="{StaticResource ModeButton}"
                                                        ToolTip="{Binding ModeTooltip}"
                                                        Tag="{Binding}"
                                                        Click="ToggleMode_Click"/>
                                                <!-- Pattern -->
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{Binding ModeTooltip}"/>
                                                <!-- Match count badge -->
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding MatchBadge}"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"/>
                                                <!-- Remove -->
                                                <Button Grid.Column="6"
                                                        Content="x"
                                                        Style="{StaticResource DangerButton}"
                                                        Width="22" Height="22" Padding="0"
                                                        Tag="{Binding}"
                                                        Click="RemoveTerm_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Divider -->
            <Border Grid.Column="1" Background="{StaticResource CardBorderBrush}"/>

            <!-- ────────────────────────────────────────────────
                 COLUMN 2 — RESULTS
            ──────────────────────────────────────────────────── -->
            <DockPanel Grid.Column="2" Background="{StaticResource BackgroundBrush}">

                <Border DockPanel.Dock="Top"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,7">
                    <Grid>
                        <TextBlock x:Name="ResultsHeader"
                                   Text="RESULTS"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <Button Content="EXPORT HTML"
                                Style="{StaticResource SurfaceButton}"
                                HorizontalAlignment="Right"
                                Padding="8,3" FontSize="10"
                                VerticalAlignment="Center"
                                Click="Export_Click"/>
                    </Grid>
                </Border>

                <ListBox x:Name="ResultsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,6"
                         Focusable="False"
                         FocusVisualStyle="{x:Null}"
                         SelectionMode="Single"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"                   Value="0"/>
                            <Setter Property="Margin"                    Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SearchResult}">
                                <Border Style="{StaticResource Card}"
                                        BorderThickness="1,1,1,1"
                                        Padding="0"
                                        Margin="0,0,0,6">
                                    <!-- File header -->
                                    <StackPanel>
                                        <Border BorderBrush="{StaticResource PrimaryPressedBrush}"
                                                BorderThickness="2,0,0,0"
                                                CornerRadius="3,3,0,0"
                                                Padding="10,6"
                                                Cursor="Hand"
                                                Tag="{Binding FilePath}"
                                                ToolTip="Click to reveal in Explorer  |  Right-click for more"
                                                MouseLeftButtonUp="ResultHeader_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource TableHeaderBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                                <Border.ContextMenu>
                                                    <ContextMenu Tag="{Binding FilePath}">
                                                        <MenuItem Header="Open file"
                                                                  Tag="{Binding PlacementTarget.Tag,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Click="OpenFile_Click"/>
                                                        <MenuItem Header="Show in Explorer"
                                                                  Tag="{Binding PlacementTarget.Tag,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Click="ShowInExplorer_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Directory}"
                                                               Foreground="{StaticResource DimTextBrush}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border Background="{StaticResource PrimaryPressedBrush}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        CornerRadius="3"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding TotalMatchCount}"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Per-term match groups -->
                                        <ItemsControl ItemsSource="{Binding Matches}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:TermMatch}">
                                                    <StackPanel Margin="10,6,10,4">
                                                        <TextBlock Foreground="{StaticResource PrimaryPressedBrush}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10" Margin="0,0,0,3">
                                                            <Run Text="["/><Run Text="{Binding Term.ModeLabel, Mode=OneWay}"/><Run Text="]  "/><Run Text="{Binding Term.Pattern}" Foreground="{StaticResource MutedTextBrush}"/>
                                                        </TextBlock>
                                                        <ItemsControl ItemsSource="{Binding Lines}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:LineMatch}">
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="42"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding LineNumber}"
                                                                                   Foreground="{StaticResource DimTextBrush}"
                                                                                   FontFamily="{StaticResource MonoFont}"
                                                                                   FontSize="10"
                                                                                   HorizontalAlignment="Right"
                                                                                   Margin="0,0,8,0"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding LineText}"
                                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                                   FontFamily="{StaticResource MonoFont}"
                                                                                   FontSize="11"
                                                                                   TextWrapping="Wrap"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

        </Grid>

        <!-- ══════════════════════════════════════════════════════
             ROW 4 — FOOTER
        ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="VersionLabel" Text="v0.1.0"
                           Foreground="#444444" FontFamily="{StaticResource MonoFont}"
                           FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock FontSize="10" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}">
                    <Run Text="&#x00A9; 2026 " Foreground="#444444"/>
                    <Hyperlink NavigateUri="https://thekiller.net"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="#444444" TextDecorations="None">
                        <Run Text="Steve the Killer"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

    </Grid>
</Window>
